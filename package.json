{
  "name": "dsh-usage-guard",
  "version": "0.1.0",
  "description": "DSH 用量统计插件：token 采集、活跃热力图、费用估算、超限守卫",
  "license": "MIT",
  "author": "HB <wzdshb@126.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hb-degithub/dsh-usage-guard.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "usage",
    "tokens",
    "statistics",
    "cost",
    "guard"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsdown && node scripts/wrap-client.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:parity": "node scripts/verify-usage-parity.mjs",
    "check": "npm run test && npm run build && npm run verify:bundle",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "exports": {
    ".": "./host/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "host",
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
