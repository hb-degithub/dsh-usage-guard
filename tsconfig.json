{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["react"]
  },
  "include": ["client/**/*.ts", "client/**/*.tsx"],
  "exclude": ["client/**/*.test.tsx", "client/**/*.test.ts"]
}
